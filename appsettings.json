{
  "Application": {
    "Name": "Accyourate Enterprise X",
    "Version": "5.6",
    "Environment": "Development"
  },
  "Database": {
    "Provider": "SQLite",
    "AutoMigrate": true,
    "BackupBeforeMigration": true
  },
  "Logging": {
    "Enabled": true,
    "Level": "Information",
    "Folder": "%ProgramData%/Accyourate Enterprise X/logs"
  },
  "Features": {
    "ApiFoundation": true,
    "PluginSystem": false,
    "AutoUpdate": false,
    "Telemetry": false
  },
  "Ui": {
    "Theme": "Light",
    "PrimaryColor": "#B5162B"
  }
}